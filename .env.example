# === Gemini 規格解析金鑰（若無設定，add_products.py 也會自動讀取 ../Coupang_Affiliate/.env）===
GEMINI_API_KEY=""

# === 全站廣告一鍵開關與版位設定 ===
# 總開關：false = 完全隱藏廣告區塊（預設）；true = 啟用（依 PUBLIC_ADS_MODE 切換模式）
PUBLIC_ADS_ENABLED="false"

# 模式：
# - preview：本機調版用，顯示「廣告預留版位」虛線框與建議尺寸
# - adsense：正式上線模式，自動載入 Google AdSense 與各版位代碼
# - off：強制關閉
PUBLIC_ADS_MODE="preview"

# Google AdSense 發佈商 ID（格式：ca-pub-xxxxxxxxxxxxxxxx，填入後會自動產生 /ads.txt）
PUBLIC_ADSENSE_CLIENT=""

# 各版位對應的 AdSense 廣告單元 ID（未填寫的版位不會輸出空框）
PUBLIC_ADSENSE_SLOT_HOME_FEED=""
PUBLIC_ADSENSE_SLOT_ITEM_CALC=""
PUBLIC_ADSENSE_SLOT_ITEM_BOTTOM=""
PUBLIC_ADSENSE_SLOT_FOOTER=""

# === 流量統計與分潤點擊追蹤（GA4 + Cloudflare Web Analytics）===
# Google Analytics 4 評估 ID（格式：G-XXXXXXXXXX；留空則不載入外部腳本）
PUBLIC_GA_MEASUREMENT_ID=""

# 選填：Cloudflare Web Analytics Beacon Token（與 GA4 可同時使用）
PUBLIC_CF_ANALYTICS_TOKEN=""

# 開發除錯用：true 時會在瀏覽器 Console 印出追蹤事件並送出 GA4 debug_mode
PUBLIC_ANALYTICS_DEBUG="false"
